FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
RUN pip install --no-cache-dir .
RUN python -m playwright install --with-deps chromium

COPY app ./app

CMD ["celery", "-A", "app.celery_app:celery_app", "worker", "--queues=execution", "--pool=prefork", "--concurrency=1", "--max-tasks-per-child=1"]
