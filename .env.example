COMPOSE_PROJECT_NAME=harness-studio

# Public app ports exposed on the host for local development. In production,
# Caddy/Nginx should be the public entry point and proxy to these services.
FRONTEND_PORT=3000
API_PORT=8080
EXECUTION_API_PORT=8090
ARTIFACT_SERVICE_PORT=8091
REPORT_SERVICE_PORT=8092

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=harness
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_dev_password
DATABASE_URL=postgres://harness:harness_dev_password@postgres:5432/harness?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Execution pipeline
EXECUTION_API_BASE_URL=http://execution-api:8090
EXECUTION_DISPATCH_TIMEOUT_SECONDS=5
ARTIFACT_SERVICE_BASE_URL=http://artifact-service:8091
ARTIFACT_SERVICE_TIMEOUT_SECONDS=10
ARTIFACT_ROOT=/data/artifacts
ARCHIVE_MAX_FILES=1000
REPORT_SERVICE_BASE_URL=http://report-service:8092
REPORT_SERVICE_TIMEOUT_SECONDS=30
EXECUTION_QUEUE=execution
MAINTENANCE_QUEUE=maintenance
LEASE_SECONDS=60
HEARTBEAT_SECONDS=5
MAX_ATTEMPTS=2

# Auth bootstrap
JWT_SECRET=local-dev-secret-change-me
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_HOURS=720
BOOTSTRAP_ADMIN_EMAIL=test@example.com
BOOTSTRAP_ADMIN_PASSWORD=Test@$1234
DISABLE_AUTH=false

# Frontend
VITE_API_BASE_URL=http://localhost:8080
