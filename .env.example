COMPOSE_PROJECT_NAME=harness-studio

# Public app ports exposed on the host for local development. In production,
# Caddy/Nginx should be the public entry point and proxy to these services.
FRONTEND_PORT=3000
API_PORT=8080
EXECUTION_API_PORT=8090
ARTIFACT_SERVICE_PORT=8091
REPORT_SERVICE_PORT=8092

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=harness
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_dev_password
DATABASE_URL=postgres://harness:harness_dev_password@postgres:5432/harness?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Execution pipeline
EXECUTION_API_BASE_URL=http://execution-api:8090
EXECUTION_DISPATCH_TIMEOUT_SECONDS=5
ARTIFACT_SERVICE_BASE_URL=http://artifact-service:8091
ARTIFACT_SERVICE_TIMEOUT_SECONDS=10
ARTIFACT_ROOT=/data/artifacts
ARCHIVE_MAX_FILES=1000
REPORT_SERVICE_BASE_URL=http://report-service:8092
REPORT_SERVICE_TIMEOUT_SECONDS=30
EXECUTION_QUEUE=execution
MAINTENANCE_QUEUE=maintenance
LEASE_SECONDS=60
HEARTBEAT_SECONDS=5
MAX_ATTEMPTS=2

# Max steps the computer-use (VLM) agent may take per iteration.
# Per-model override available via the model definition's config.maxSteps.
CUA_MAX_STEPS=20

# Worker parallelism (replica scaling model). WORKER_EXECUTION_REPLICAS is the number of
# worker-execution containers = max iterations in parallel; each stays --concurrency=1.
# WORKER_ID is intentionally NOT set so each replica derives a unique id from its hostname.
WORKER_EXECUTION_REPLICAS=6
WORKER_EXECUTION_MEMORY=1g
WORKER_PREFETCH_MULTIPLIER=1
VISIBILITY_TIMEOUT_SECONDS=9000
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# worker-scaler (internal service that scales worker-execution via docker-socket-proxy)
WORKER_SCALER_BASE_URL=http://worker-scaler:8093
WORKER_SCALER_TIMEOUT_SECONDS=15
DOCKER_API_URL=http://docker-socket-proxy:2375
FLOWER_BASE_URL=http://flower:5555
FLOWER_URL_PREFIX=flower
WORKER_EXECUTION_MIN_REPLICAS=0
WORKER_EXECUTION_MAX_REPLICAS=200

# Model registry/runtime config
# Store these names as secretRef values in catalog.model_providers or catalog.system_config;
# do not store raw API keys in Postgres.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_MODEL_ADAPTER_KEY=text_only
DEFAULT_MODEL_CALL_TIMEOUT_SECONDS=60

# Auth bootstrap
JWT_SECRET=local-dev-secret-change-me
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_HOURS=720
BOOTSTRAP_ADMIN_EMAIL=test@example.com
BOOTSTRAP_ADMIN_PASSWORD=Test@$1234
DISABLE_AUTH=false

# Frontend
VITE_API_BASE_URL=http://localhost:8080
