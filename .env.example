COMPOSE_PROJECT_NAME=harness-studio

# Public app ports exposed on the host for local development. In production,
# Caddy/Nginx should be the public entry point and proxy to these services.
FRONTEND_PORT=3000
API_PORT=8080

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=harness
POSTGRES_USER=harness
POSTGRES_PASSWORD=harness_dev_password
DATABASE_URL=postgres://harness:harness_dev_password@postgres:5432/harness?sslmode=disable

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Auth bootstrap
JWT_SECRET=local-dev-secret-change-me
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_HOURS=720
BOOTSTRAP_ADMIN_EMAIL=test@example.com
BOOTSTRAP_ADMIN_PASSWORD=Test@$1234
DISABLE_AUTH=false

# Frontend
VITE_API_BASE_URL=http://localhost:8080
